            "additional_input_description": "",
            "show_output": false
          }
        }
      }
    },
    {
      "param_name": "install gnome-tweaks",
      "param_type": {
        "Bool": {
          "command": {
            "base": "pacman -S --noconfirm gnome-tweaks",
            "need_additional_input": false,
            "additional_input_description": "",
            "show_output": false
          }
        }
      }
    }
